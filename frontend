<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gamified Calendar</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f3f4f6;
        }
    </style>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center p-4">

    <div id="loading-spinner" class="flex flex-col items-center justify-center fixed inset-0 bg-gray-100 z-50">
        <svg class="animate-spin -ml-1 mr-3 h-10 w-10 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <p class="mt-4 text-gray-700">Loading and authenticating...</p>
    </div>

    <div id="main-content" class="w-full max-w-4xl bg-white rounded-2xl shadow-xl overflow-hidden hidden">
        <div class="md:flex">
            <div class="md:w-1/3 bg-gray-800 text-white p-6 md:p-8 flex flex-col items-center justify-center">
                <h1 class="text-3xl font-bold mb-2">My Road Map</h1>
                <p class="text-sm text-gray-400 text-center">Your personalized productivity assistant</p>
                <div class="mt-8 text-center">
                    <p class="text-sm text-gray-400">Your User ID (share with friends):</p>
                    <p id="user-id" class="font-mono text-xs break-all mt-1 bg-gray-700 p-2 rounded-lg"></p>
                </div>
                <div class="mt-8 flex flex-col items-center space-y-4 w-full">
                    <div id="productivity-score-card" class="bg-gray-700 rounded-xl p-4 w-full text-center shadow-lg">
                        <p class="text-sm text-gray-400">Productivity Score</p>
                        <p id="productivity-score" class="text-4xl font-extrabold text-green-400 mt-2">0</p>
                    </div>
                </div>
            </div>

            <div class="md:w-2/3 p-6 md:p-8">
                <div id="message-area" class="bg-yellow-100 text-yellow-800 p-3 rounded-xl mb-6 text-sm hidden">
                    <p><strong>Note:</strong> This is a simulated environment. Features like Google Calendar, YouTube, and real-time syncing are mocked to show how they would function.</p>
                </div>

                <!-- Section: iCal Import -->
                <div class="mb-8">
                    <h2 class="text-2xl font-bold text-gray-800 mb-4">1. Import Your Calendar</h2>
                    <p class="text-gray-600 mb-4">Paste your iCal link here to import your events. We'll find free time slots for your tasks.</p>
                    <textarea id="ical-input" rows="4" class="w-full p-3 border border-gray-300 rounded-xl focus:ring-blue-500 focus:border-blue-500 transition"></textarea>
                    <button id="import-btn" class="mt-4 w-full bg-blue-600 text-white p-3 rounded-xl font-bold hover:bg-blue-700 transition">Import Calendar</button>
                    <p id="import-status" class="mt-2 text-sm text-gray-500"></p>
                </div>

                <!-- Section: Task Management -->
                <div class="mb-8">
                    <h2 class="text-2xl font-bold text-gray-800 mb-4">2. Your Tasks & Learning</h2>
                    <p class="text-gray-600 mb-4">Add a new task or learning topic below. We'll fetch relevant content and schedule it.</p>
                    <div class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4">
                        <input id="task-input" type="text" placeholder="e.g., Learn Python, Finish report" class="flex-grow p-3 border border-gray-300 rounded-xl focus:ring-green-500 focus:border-green-500 transition">
                        <button id="add-task-btn" class="bg-green-600 text-white p-3 rounded-xl font-bold hover:bg-green-700 transition">Add Task</button>
                    </div>
                    <div id="tasks-list" class="mt-4 space-y-3"></div>
                </div>

                <!-- Section: Gamified Features -->
                <div class="mb-8">
                    <h2 class="text-2xl font-bold text-gray-800 mb-4">3. Productivity Actions</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <button id="flashcard-btn" class="bg-purple-600 text-white p-4 rounded-xl font-bold hover:bg-purple-700 transition flex items-center justify-center">
                            <span class="mr-2">🧠</span> Suggest Morning Flash Cards
                        </button>
                        <button id="share-btn" class="bg-indigo-600 text-white p-4 rounded-xl font-bold hover:bg-indigo-700 transition flex items-center justify-center">
                            <span class="mr-2">🤝</span> Sync Events with Friends
                        </button>
                    </div>
                    <div id="gamified-actions-status" class="mt-4 text-sm text-gray-500"></div>
                </div>

                <!-- Section: Scheduled Roadmap -->
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 mb-4">4. Your Roadmap</h2>
                    <p class="text-gray-600 mb-4">Your tasks and learning materials, automatically fitted into your calendar based on available time.</p>
                    <div id="roadmap-list" class="space-y-4">
                        <p class="text-gray-400 text-center">No roadmap generated yet. Add a task to get started!</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal for Custom Confirmation/Alerts -->
    <div id="modal-backdrop" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-50 hidden items-center justify-center p-4">
      <div id="modal-content" class="bg-white rounded-xl p-6 max-w-sm w-full shadow-lg">
        <h3 id="modal-title" class="text-xl font-bold mb-2 text-gray-800"></h3>
        <p id="modal-message" class="text-gray-600 mb-4"></p>
        <div class="flex justify-end space-x-2">
          <button id="modal-cancel-btn" class="px-4 py-2 bg-gray-200 text-gray-800 rounded-md font-bold hover:bg-gray-300 transition">Cancel</button>
          <button id="modal-confirm-btn" class="px-4 py-2 bg-blue-600 text-white rounded-md font-bold hover:bg-blue-700 transition">OK</button>
        </div>
      </div>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, getDoc, addDoc, setDoc, updateDoc, deleteDoc, onSnapshot, collection, query, where, getDocs, arrayUnion } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";
        import { setLogLevel } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        setLogLevel('debug');
        
        // Modal UI Elements
        const modalBackdrop = document.getElementById('modal-backdrop');
        const modalTitle = document.getElementById('modal-title');
        const modalMessage = document.getElementById('modal-message');
        const modalConfirmBtn = document.getElementById('modal-confirm-btn');
        const modalCancelBtn = document.getElementById('modal-cancel-btn');
        
        function showModal(title, message, onConfirm, onCancel) {
          modalTitle.textContent = title;
          modalMessage.textContent = message;
          modalBackdrop.classList.remove('hidden');
          modalBackdrop.classList.add('flex');
          
          modalConfirmBtn.onclick = () => {
            modalBackdrop.classList.add('hidden');
            modalBackdrop.classList.remove('flex');
            if (onConfirm) onConfirm();
          };
          
          modalCancelBtn.onclick = () => {
            modalBackdrop.classList.add('hidden');
            modalBackdrop.classList.remove('flex');
            if (onCancel) onCancel();
          };
        }

        const icalInput = document.getElementById('ical-input');
        const importBtn = document.getElementById('import-btn');
        const importStatus = document.getElementById('import-status');
        const taskInput = document.getElementById('task-input');
        const addTaskBtn = document.getElementById('add-task-btn');
        const tasksList = document.getElementById('tasks-list');
        const flashcardBtn = document.getElementById('flashcard-btn');
        const shareBtn = document.getElementById('share-btn');
        const roadmapList = document.getElementById('roadmap-list');
        const productivityScoreEl = document.getElementById('productivity-score');
        const messageArea = document.getElementById('message-area');
        const gamifiedActionsStatus = document.getElementById('gamified-actions-status');
        const userIdEl = document.getElementById('user-id');
        const loadingSpinner = document.getElementById('loading-spinner');
        const mainContent = document.getElementById('main-content');

        const GAMIFICATION_POINTS = {
            TASK_COMPLETED: 10,
            VIDEO_WATCHED: 5,
            ROADMAP_GENERATED: 20
        };

        const MOCK_EVENTS = [
            {
                summary: 'Team Meeting',
                start: '2025-09-20T10:00:00',
                end: '2025-09-20T11:00:00'
            },
            {
                summary: 'Lunch',
                start: '2025-09-20T12:00:00',
                end: '2025-09-20T13:00:00'
            },
            {
                summary: 'Project Deadline Prep',
                start: '2025-09-21T14:00:00',
                end: '2025-09-21T16:00:00'
            },
        ];

        let db, auth, userId, productivityScore = 0;
        let userTasks = [];
        let userCalendar = [];

        // Firebase Setup
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {};

        try {
            const app = initializeApp(firebaseConfig);
            db = getFirestore(app);
            auth = getAuth(app);
        } catch (e) {
            console.error("Firebase initialization failed:", e);
        }

        const userDataCollection = (uid) => collection(db, `artifacts/${appId}/users/${uid}/calendar_data`);
        const sharedCalendarsCollection = collection(db, `artifacts/${appId}/public/data/shared_calendars`);

        // Authentication and Data Loading
        onAuthStateChanged(auth, async (user) => {
            if (user) {
                userId = user.uid;
                userIdEl.textContent = userId;
                console.log("Authenticated with user ID:", userId);

                // Set up real-time listener for user data
                const userDocRef = doc(userDataCollection(userId), 'user_profile');
                onSnapshot(userDocRef, (docSnap) => {
                    if (docSnap.exists()) {
                        const data = docSnap.data();
                        productivityScore = data.productivityScore || 0;
                        userTasks = data.tasks || [];
                        userCalendar = data.calendar || [];
                        updateUI();
                        console.log("User data updated in real-time:", data);
                    } else {
                        console.log("No user profile found, creating a new one.");
                        setDoc(userDocRef, { productivityScore: 0, tasks: [], calendar: [] });
                    }
                    loadingSpinner.classList.add('hidden');
                    mainContent.classList.remove('hidden');
                    messageArea.classList.remove('hidden');
                }, (error) => {
                    console.error("Error listening to user data:", error);
                });

            } else {
                console.log("No user authenticated. Signing in anonymously.");
                try {
                    const token = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;
                    if (token) {
                        await signInWithCustomToken(auth, token);
                    } else {
                        await signInAnonymously(auth);
                    }
                } catch (e) {
                    console.error("Authentication failed:", e);
                }
            }
        });

        const updateUI = () => {
            productivityScoreEl.textContent = productivityScore;
            renderTasks();
            renderRoadmap();
        };

        const renderTasks = () => {
            tasksList.innerHTML = '';
            if (userTasks.length === 0) {
                tasksList.innerHTML = '<p class="text-gray-400 text-center">No tasks added yet.</p>';
            }
            userTasks.forEach((task, index) => {
                const taskItem = document.createElement('div');
                taskItem.className = `flex items-center justify-between p-3 rounded-xl shadow-sm border ${task.completed ? 'bg-green-100 border-green-300' : 'bg-white border-gray-200'}`;
                taskItem.innerHTML = `
                    <p class="text-gray-800 ${task.completed ? 'line-through text-gray-500' : ''}">${task.name}</p>
                    <div class="flex items-center space-x-2">
                        <button data-index="${index}" class="complete-task-btn p-2 rounded-full hover:bg-green-200 transition">
                            <svg class="h-5 w-5 ${task.completed ? 'text-green-500' : 'text-gray-400'}" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                        </button>
                        <button data-index="${index}" class="delete-task-btn p-2 rounded-full hover:bg-red-200 transition">
                            <svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm6 0a1 1 0 01-2 0v6a1 1 0 112 0V8z" clip-rule="evenodd"></path></svg>
                        </button>
                    </div>
                `;
                tasksList.appendChild(taskItem);
            });

            document.querySelectorAll('.complete-task-btn').forEach(btn => {
                btn.addEventListener('click', async (e) => {
                    const index = parseInt(e.currentTarget.dataset.index);
                    if (userTasks[index]) {
                        userTasks[index].completed = !userTasks[index].completed;
                        if (userTasks[index].completed) {
                            productivityScore += GAMIFICATION_POINTS.TASK_COMPLETED;
                        } else {
                            productivityScore -= GAMIFICATION_POINTS.TASK_COMPLETED;
                        }
                        await saveUserData();
                    }
                });
            });

            document.querySelectorAll('.delete-task-btn').forEach(btn => {
                btn.addEventListener('click', async (e) => {
                    const index = parseInt(e.currentTarget.dataset.index);
                    if (userTasks[index]) {
                        userTasks.splice(index, 1);
                        await saveUserData();
                    }
                });
            });
        };

        const renderRoadmap = () => {
            roadmapList.innerHTML = '';
            if (userTasks.length === 0) {
                roadmapList.innerHTML = '<p class="text-gray-400 text-center">No roadmap generated yet. Add a task to get started!</p>';
                return;
            }
            roadmapList.innerHTML = '<h3 class="font-bold text-lg mb-2 text-gray-700">Today\'s Agenda:</h3>';
            userTasks.forEach((task, index) => {
                const roadmapItem = document.createElement('div');
                roadmapItem.className = 'bg-blue-50 p-4 rounded-xl shadow-sm border border-blue-200';
                roadmapItem.innerHTML = `
                    <div class="flex items-center justify-between">
                        <p class="font-bold text-blue-800">${task.name}</p>
                        <span class="text-sm text-blue-600">Scheduled: ${new Date(Date.now() + index * 3600000).toLocaleTimeString()}</span>
                    </div>
                    ${task.content && task.content.videos ? `
                        <div class="mt-2 text-sm text-gray-700">
                            <p class="font-semibold mb-1">Learning Resources:</p>
                            <ul class="list-disc list-inside space-y-1">
                                ${task.content.videos.map(video => `<li><a href="#" class="text-blue-500 hover:underline">${video.title}</a> (Duration: ${video.duration})</li>`).join('')}
                            </ul>
                        </div>
                    ` : ''}
                `;
                roadmapList.appendChild(roadmapItem);
            });
        };

        const saveUserData = async () => {
            if (!userId) {
                console.error("User ID not available to save data.");
                return;
            }
            const userDocRef = doc(userDataCollection(userId), 'user_profile');
            try {
                await updateDoc(userDocRef, {
                    productivityScore: productivityScore,
                    tasks: userTasks,
                    calendar: userCalendar,
                });
                console.log("User data saved successfully.");
            } catch (e) {
                console.error("Error saving user data:", e);
            }
        };

        // --- Event Listeners ---
        importBtn.addEventListener('click', () => {
            const icalLink = icalInput.value;
            if (icalLink) {
                importStatus.textContent = 'Parsing iCal data... (Simulated)';
                importStatus.className = 'mt-2 text-sm text-blue-500';
                setTimeout(() => {
                    userCalendar = MOCK_EVENTS;
                    importStatus.textContent = `Calendar imported! Found ${userCalendar.length} events.`;
                    importStatus.className = 'mt-2 text-sm text-green-500';
                    saveUserData();
                    createRoadmap();
                }, 1500);
            } else {
                importStatus.textContent = 'Please paste an iCal link.';
                importStatus.className = 'mt-2 text-sm text-red-500';
            }
        });

        addTaskBtn.addEventListener('click', async () => {
            const taskName = taskInput.value.trim();
            if (taskName) {
                const newTask = { name: taskName, completed: false, content: {} };
                showStatusMessage('Adding task and fetching learning resources...', 'blue');
                await fetchLearningResources(newTask);
                userTasks.push(newTask);
                taskInput.value = '';
                await saveUserData();
                showStatusMessage('Task added!', 'green', 1500);
                createRoadmap();
            }
        });

        flashcardBtn.addEventListener('click', () => {
            showStatusMessage('Suggesting flash cards for the morning...', 'purple');
            setTimeout(() => {
                showStatusMessage('Flash cards on "JavaScript Fundamentals" and "Python Syntax" have been scheduled for tomorrow morning at 8:00 AM!', 'green');
            }, 2000);
        });

        shareBtn.addEventListener('click', () => {
          showModal(
            'Sync with Friends',
            'Your calendar events and tasks will be shared with other users who follow your User ID. Do you want to continue?',
            async () => {
              gamifiedActionsStatus.textContent = 'Syncing events with friends... (Simulated)';
              gamifiedActionsStatus.className = 'mt-4 text-sm text-indigo-500';
              
              // Simulating sharing data
              const userSharedDocRef = doc(sharedCalendarsCollection, userId);
              await setDoc(userSharedDocRef, {
                userId: userId,
                calendar: userCalendar,
                tasks: userTasks,
                lastUpdated: new Date()
              });

              // Also simulate fetching friends' data
              setTimeout(async () => {
                const friendsSnapshot = await getDocs(query(sharedCalendarsCollection, where("userId", "!=", userId)));
                let friendCalendars = [];
                friendsSnapshot.forEach(doc => {
                  friendCalendars.push(doc.data().calendar);
                });
                console.log("Simulated friend calendars fetched:", friendCalendars);
                gamifiedActionsStatus.textContent = 'Syncing complete! Found mutual free time slots with friends and updated your calendar.';
                gamifiedActionsStatus.className = 'mt-4 text-sm text-green-500';
              }, 2000);
            }
          );
        });

        const showStatusMessage = (message, color, duration = 3000) => {
            gamifiedActionsStatus.textContent = message;
            gamifiedActionsStatus.className = `mt-4 text-sm text-${color}-500`;
            setTimeout(() => {
                gamifiedActionsStatus.textContent = '';
                gamifiedActionsStatus.className = '';
            }, duration);
        };

        const fetchLearningResources = async (task) => {
            await new Promise(resolve => setTimeout(resolve, 2000));
            if (task.name.toLowerCase().includes('python')) {
                task.content.videos = [
                    { title: 'Python for Beginners - Full Course [2025]', duration: '2h 30min' },
                    { title: 'Learn Python in 15 Minutes', duration: '15min' }
                ];
            } else if (task.name.toLowerCase().includes('report')) {
                task.content.videos = [
                    { title: 'How to Write a Professional Report', duration: '12min' },
                    { title: 'Advanced Report Writing Tips', duration: '25min' }
                ];
            }
            productivityScore += GAMIFICATION_POINTS.ROADMAP_GENERATED;
        };

        const createRoadmap = () => {
            if (userTasks.length > 0) {
                renderRoadmap();
            }
        };

    </script>
</body>
</html>
